{
  "$defs": {
    "A2Error": {
      "additionalProperties": false,
      "description": "Safe structured error returned across the MCP boundary.",
      "properties": {
        "code": {
          "$ref": "#/$defs/A2ErrorCode"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "A2Error",
      "type": "object"
    },
    "A2ErrorCode": {
      "enum": [
        "TIMEOUT",
        "RATE_LIMITED",
        "UPSTREAM_HTTP_ERROR",
        "UPSTREAM_PARSE_ERROR",
        "INVALID_REQUEST",
        "NOT_FOUND",
        "UNSUPPORTED_SOURCE",
        "CACHE_ERROR",
        "MCP_ERROR",
        "INTERNAL_ERROR"
      ],
      "title": "A2ErrorCode",
      "type": "string"
    },
    "A2Evidence": {
      "additionalProperties": false,
      "description": "Frozen A2 source-normalized evidence contract.",
      "properties": {
        "abstract_or_chunk": {
          "minLength": 1,
          "title": "Abstract Or Chunk",
          "type": "string"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "comparator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparator"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "evidence_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Level"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "guideline_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guideline Name"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "intervention": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intervention"
        },
        "mock": {
          "default": false,
          "title": "Mock",
          "type": "boolean"
        },
        "nct_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nct Id"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "pmid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pmid"
        },
        "population": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "schema_version": {
          "default": "a2-evidence-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_metadata": {
          "additionalProperties": true,
          "title": "Source Metadata",
          "type": "object"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id",
        "source_type",
        "title",
        "abstract_or_chunk",
        "content_hash"
      ],
      "title": "A2Evidence",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "pubmed",
        "europe_pmc",
        "clinical_trials",
        "guideline"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "ToolDiagnostics": {
      "additionalProperties": true,
      "properties": {
        "cache_hit": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Hit"
        },
        "latency_ms": {
          "default": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "result_count": {
          "default": 0,
          "title": "Result Count",
          "type": "integer"
        },
        "retry_count": {
          "default": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "schema_version": {
          "default": "a2-evidence-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "upstream_api_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Api Version"
        },
        "upstream_request_count": {
          "default": 0,
          "title": "Upstream Request Count",
          "type": "integer"
        }
      },
      "required": [
        "tool_name"
      ],
      "title": "ToolDiagnostics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Uniform structured MCP tool envelope.",
  "properties": {
    "diagnostics": {
      "$ref": "#/$defs/ToolDiagnostics"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/A2Error"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/A2Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "schema_version": {
      "default": "a2-evidence-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "ok",
    "diagnostics"
  ],
  "title": "ToolResponse",
  "type": "object"
}
