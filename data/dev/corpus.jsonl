{"chunk_id": "dia-guide-2024", "evidence_id": "ev-dia-guide-2024", "stable_id": "GUIDELINE:CDS-Diabetes-2024", "title": "中国 2 型糖尿病防治指南（2024 年版）——药物治疗章节", "text": "中国 2 型糖尿病防治指南推荐二甲双胍作为多数患者的初始治疗药物，若血糖不达标可联合 SGLT2 抑制剂、DPP-4 抑制剂等。合并心血管疾病或高风险者优先选择具有心血管获益证据的药物。", "source_type": "guideline", "url": "https://www.cds.org.cn/guideline/2024", "published_at": "2024-04-10", "evidence_level": "guideline", "topic": "diabetes", "pico_population": ["type 2 diabetes"], "pico_intervention": ["metformin", "sglt2 inhibitor"], "pico_comparator": [], "pico_outcome": ["glucose", "glycemic control"], "page": "20-27", "section": "药物治疗", "token_count": 0, "pmid": "", "doi": "10.3760/cma.j.cn112138-20240410-00244", "nct_id": "", "authors": ["中华医学会糖尿病学分会"], "guideline_name": "中国2型糖尿病防治指南（2024年版）", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "dia-rct-metformin", "evidence_id": "ev-dia-rct-metformin", "stable_id": "PMID:36700015", "title": "Metformin monotherapy in newly diagnosed type 2 diabetes: a randomized trial", "text": "This randomized trial compared metformin with lifestyle advice alone in 1,200 patients with newly diagnosed type 2 diabetes. Metformin reduced HbA1c by 1.1 percentage points over 18 months and improved fasting glucose without weight gain.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/36700015/", "published_at": "2021-07-15", "evidence_level": "rct", "topic": "diabetes", "pico_population": ["type 2 diabetes"], "pico_intervention": ["metformin"], "pico_comparator": ["lifestyle advice"], "pico_outcome": ["glucose", "glycemic control"], "page": "", "section": "abstract", "token_count": 0, "pmid": "36700015", "doi": "10.1000/diab.2021.07.015", "nct_id": "", "authors": ["Gonzalez R", "Yamada K"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "dia-rct-sglt2", "evidence_id": "ev-dia-rct-sglt2", "stable_id": "PMID:37000016", "title": "SGLT2 inhibitor added to metformin in type 2 diabetes: a randomized trial", "text": "A randomized trial added an SGLT2 inhibitor or placebo to metformin in 1,400 patients with type 2 diabetes. The SGLT2 inhibitor improved glycemic control, reduced body weight, and lowered the risk of hospitalization for heart failure.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/37000016/", "published_at": "2023-02-28", "evidence_level": "rct", "topic": "diabetes", "pico_population": ["type 2 diabetes"], "pico_intervention": ["sglt2 inhibitor", "metformin"], "pico_comparator": ["placebo"], "pico_outcome": ["glucose", "glycemic control"], "page": "", "section": "abstract", "token_count": 0, "pmid": "37000016", "doi": "10.1000/diab.2023.02.028", "nct_id": "", "authors": ["Bauer T", "Ivanov S"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
