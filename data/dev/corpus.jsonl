{"chunk_id": "dia-trial-2025", "evidence_id": "ev-dia-trial-2025", "stable_id": "NCT07700017", "title": "Early combination therapy in type 2 diabetes: a 2025 randomized trial", "text": "This 2025 randomized trial compared early combination of metformin with an SGLT2 inhibitor versus metformin monotherapy escalation in 2,000 patients. Early combination achieved glycemic targets sooner and improved cardiovascular risk markers.", "source_type": "trials", "url": "https://clinicaltrials.gov/study/NCT07700017", "published_at": "2025-03-18", "evidence_level": "trial", "topic": "diabetes", "pico_population": ["type 2 diabetes"], "pico_intervention": ["metformin", "sglt2 inhibitor"], "pico_comparator": ["monotherapy"], "pico_outcome": ["glucose", "glycemic control"], "page": "", "section": "results", "token_count": 0, "pmid": "", "doi": "", "nct_id": "NCT07700017", "authors": ["Park J", "Olsen H"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
