{"chunk_id": "htn-guide-2024", "evidence_id": "ev-htn-guide-2024", "stable_id": "GUIDELINE:CN-Hypertension-2024", "title": "中国高血压防治指南（2024 年修订版）——老年高血压治疗章节", "text": "中国高血压防治指南推荐：老年高血压患者（年龄≥65 岁）的一线降压治疗应包括钙通道阻滞剂（如氨氯地平）、噻嗪类利尿剂、血管紧张素转换酶抑制剂（ACEI）或血管紧张素受体阻滞剂（ARB）。对老年患者的降压治疗应关注收缩压达标、血压变异性与药物耐受性，起始治疗可从单药低剂量开始，必要时联合用药。", "source_type": "guideline", "url": "https://www.chinahbp.org/guideline/2024", "published_at": "2024-08-15", "evidence_level": "guideline", "topic": "hypertension", "pico_population": ["older adults", "hypertension"], "pico_intervention": ["amlodipine", "thiazide", "acei", "arb"], "pico_comparator": [], "pico_outcome": ["blood pressure"], "page": "25-31", "section": "老年高血压", "token_count": 0, "pmid": "", "doi": "10.3760/zhfz.2024.08.001", "nct_id": "", "authors": ["中国高血压防治指南修订委员会"], "guideline_name": "中国高血压防治指南（2024年修订版）", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "htn-sr-amlodipine", "evidence_id": "ev-htn-sr-amlodipine", "stable_id": "PMID:32500001", "title": "Calcium channel blockers versus other antihypertensive classes in older adults: a systematic review", "text": "This systematic review of randomized trials compared calcium channel blockers with other first-line antihypertensive classes in adults aged 65 years and older. Amlodipine-based regimens reduced systolic blood pressure and stroke risk; tolerability was similar to thiazide diuretics and ACE inhibitors.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/32500001/", "published_at": "2020-03-10", "evidence_level": "systematic_review", "topic": "hypertension", "pico_population": ["older adults", "hypertension"], "pico_intervention": ["amlodipine"], "pico_comparator": ["thiazide", "acei"], "pico_outcome": ["blood pressure", "stroke"], "page": "", "section": "abstract", "token_count": 0, "pmid": "32500001", "doi": "10.1000/j.hypertens.2020.03.010", "nct_id": "", "authors": ["Li Y", "Zhang W", "Chen J"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "htn-rct-amlodipine", "evidence_id": "ev-htn-rct-amlodipine", "stable_id": "PMID:32800002", "title": "Amlodipine versus placebo in older adults with systolic hypertension: a randomized controlled trial", "text": "In a double-blind randomized controlled trial, 1,280 older adults with isolated systolic hypertension received amlodipine 5-10 mg or placebo for 24 months. Amlodipine reduced mean systolic blood pressure by 12 mmHg compared with placebo and lowered the incidence of cardiovascular events without increasing serious adverse events.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/32800002/", "published_at": "2019-11-20", "evidence_level": "rct", "topic": "hypertension", "pico_population": ["older adults", "hypertension"], "pico_intervention": ["amlodipine"], "pico_comparator": ["placebo"], "pico_outcome": ["blood pressure", "cardiovascular events"], "page": "", "section": "abstract", "token_count": 0, "pmid": "32800002", "doi": "10.1000/nejm.2019.11.020", "nct_id": "", "authors": ["Wang H", "Liu Q", "Sun R"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "htn-rct-chlorthalidone", "evidence_id": "ev-htn-rct-chlorthalidone", "stable_id": "PMID:28200003", "title": "Chlorthalidone compared with placebo in older adults with hypertension", "text": "This randomized trial evaluated chlorthalidone 12.5-25 mg daily versus placebo in older adults with hypertension. Thiazide diuretic treatment reduced major cardiovascular events, but the trial predates modern combination therapy and its relevance to current first-line choices is limited.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/28200003/", "published_at": "2002-12-05", "evidence_level": "rct", "topic": "hypertension", "pico_population": ["older adults", "hypertension"], "pico_intervention": ["thiazide"], "pico_comparator": ["placebo"], "pico_outcome": ["cardiovascular events"], "page": "", "section": "abstract", "token_count": 0, "pmid": "28200003", "doi": "", "nct_id": "", "authors": ["Smith AB", "Jones CD"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "htn-rct-latest-2025", "evidence_id": "ev-htn-rct-latest-2025", "stable_id": "PMID:33500004", "title": "Initiation strategies for antihypertensive treatment in 2025: a randomized controlled trial", "text": "This 2025 randomized controlled trial compared immediate initiation of amlodipine-based combination therapy with stepwise monotherapy in 3,400 adults with hypertension. Immediate combination achieved blood pressure control in more patients by month six and reduced 12-month cardiovascular events; adherence was comparable between strategies.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/33500004/", "published_at": "2025-06-15", "evidence_level": "rct", "topic": "hypertension", "pico_population": ["adults", "hypertension"], "pico_intervention": ["amlodipine", "combination therapy"], "pico_comparator": ["monotherapy"], "pico_outcome": ["blood pressure", "cardiovascular events"], "page": "", "section": "abstract", "token_count": 0, "pmid": "33500004", "doi": "10.1000/lancet.2025.06.015", "nct_id": "", "authors": ["Chen Y", "Zhao M"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "htn-trial-2024", "evidence_id": "ev-htn-trial-2024", "stable_id": "NCT05500001", "title": "Bedtime versus morning dosing of antihypertensive drugs: a randomized trial", "text": "A 2024 randomized trial assigned adults with hypertension to bedtime or morning dosing of their antihypertensive regimen. No difference in 24-hour blood pressure control was observed; the trial confirmed that dosing time should follow patient preference and adherence.", "source_type": "trials", "url": "https://clinicaltrials.gov/study/NCT05500001", "published_at": "2024-02-10", "evidence_level": "trial", "topic": "hypertension", "pico_population": ["adults", "hypertension"], "pico_intervention": ["antihypertensive drugs"], "pico_comparator": ["bedtime", "morning"], "pico_outcome": ["blood pressure"], "page": "", "section": "results", "token_count": 0, "pmid": "", "doi": "", "nct_id": "NCT05500001", "authors": ["Miller E", "Brown F"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "htn-cohort-2018", "evidence_id": "ev-htn-cohort-2018", "stable_id": "PMID:28800005", "title": "Blood pressure trajectories and cardiovascular outcomes in older adults", "text": "This cohort study followed 9,000 adults aged 65 years and older for eight years and described blood pressure trajectories. Higher systolic blood pressure trajectories were associated with increased stroke risk; the study did not test any specific antihypertensive drug.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/28800005/", "published_at": "2018-05-30", "evidence_level": "cohort", "topic": "hypertension", "pico_population": ["older adults", "hypertension"], "pico_intervention": [], "pico_comparator": [], "pico_outcome": ["stroke"], "page": "", "section": "abstract", "token_count": 0, "pmid": "28800005", "doi": "", "nct_id": "", "authors": ["Garcia H", "Kim J"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "htn-obs-2016", "evidence_id": "ev-htn-obs-2016", "stable_id": "PMID:29500006", "title": "Adherence to antihypertensive medication in Chinese primary care", "text": "An observational study of 2,100 Chinese patients with hypertension found that adherence to antihypertensive medication declined over time and was associated with treatment complexity. It reports adherence patterns only and does not compare drug efficacy.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/29500006/", "published_at": "2016-09-12", "evidence_level": "observational", "topic": "hypertension", "pico_population": ["adults", "hypertension"], "pico_intervention": [], "pico_comparator": [], "pico_outcome": [], "page": "", "section": "abstract", "token_count": 0, "pmid": "29500006", "doi": "", "nct_id": "", "authors": ["Wu X", "Tang L"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "htn-guide-2015", "evidence_id": "ev-htn-guide-2015", "stable_id": "GUIDELINE:CN-Hypertension-2015", "title": "中国高血压防治指南（2015 年修订版）——治疗章节", "text": "中国高血压防治指南（2015 年版）推荐老年高血压患者以钙通道阻滞剂、噻嗪类利尿剂或 ACEI/ARB 作为初始治疗选择，并强调血压达标与长期随访。该版本发布于 2015 年，部分推荐已被 2024 年修订版更新。", "source_type": "guideline", "url": "https://www.chinahbp.org/guideline/2015", "published_at": "2015-05-01", "evidence_level": "guideline", "topic": "hypertension", "pico_population": ["older adults", "hypertension"], "pico_intervention": ["amlodipine", "thiazide", "acei", "arb"], "pico_comparator": [], "pico_outcome": ["blood pressure"], "page": "30-38", "section": "药物治疗", "token_count": 0, "pmid": "", "doi": "", "nct_id": "", "authors": ["中国高血压防治指南修订委员会"], "guideline_name": "中国高血压防治指南（2015年修订版）", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "htn-meta-2021", "evidence_id": "ev-htn-meta-2021", "stable_id": "DOI:10.1000/htnmeta2021", "title": "First-line antihypertensive drug classes and mortality: a meta-analysis of randomized trials", "text": "This meta-analysis pooled 42 randomized trials comparing first-line antihypertensive classes. All major classes reduced cardiovascular mortality versus placebo, with modest between-class differences; calcium channel blockers showed favorable outcomes in older adults.", "source_type": "europepmc", "url": "https://europepmc.org/article/MED/htnmeta2021", "published_at": "2021-04-18", "evidence_level": "meta_analysis", "topic": "hypertension", "pico_population": ["adults", "hypertension"], "pico_intervention": ["amlodipine", "thiazide", "acei"], "pico_comparator": ["placebo"], "pico_outcome": ["mortality", "cardiovascular events"], "page": "", "section": "abstract", "token_count": 0, "pmid": "", "doi": "10.1000/htnmeta2021", "nct_id": "", "authors": ["Kumar R", "Patel S"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "htn-mechanism", "evidence_id": "ev-htn-mechanism", "stable_id": "PMID:30100008", "title": "Mechanisms of calcium-dependent vasoconstriction in hypertension", "text": "This mechanistic study examined calcium influx pathways in vascular smooth muscle and their role in sustained vasoconstriction in hypertension. It addresses pathophysiology only and provides no clinical treatment recommendation.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/30100008/", "published_at": "2017-08-22", "evidence_level": "observational", "topic": "hypertension", "pico_population": [], "pico_intervention": [], "pico_comparator": [], "pico_outcome": [], "page": "", "section": "abstract", "token_count": 0, "pmid": "30100008", "doi": "", "nct_id": "", "authors": ["Okafor C", "Ross D"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "htn-epidemiology", "evidence_id": "ev-htn-epidemiology", "stable_id": "PMID:31000009", "title": "Prevalence of hypertension among Chinese adults", "text": "A national survey estimated that nearly one in four Chinese adults has hypertension, with higher prevalence in older age groups. The report covers disease burden and awareness but not treatment efficacy.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/31000009/", "published_at": "2019-01-15", "evidence_level": "observational", "topic": "hypertension", "pico_population": ["adults"], "pico_intervention": [], "pico_comparator": [], "pico_outcome": [], "page": "", "section": "abstract", "token_count": 0, "pmid": "31000009", "doi": "", "nct_id": "", "authors": ["Zhou B", "Carrillo-Larco RM"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "lipid-guide-2023", "evidence_id": "ev-lipid-guide-2023", "stable_id": "GUIDELINE:CN-Lipid-2023", "title": "中国血脂管理指南（2023 年）——药物治疗章节", "text": "中国血脂管理指南推荐：他汀类药物是降低 LDL-C 的一线药物；单用他汀不达标时，可联合依折麦布或 PCSK9 抑制剂。对心血管高危患者，LDL-C 目标值应低于 1.8 mmol/L。", "source_type": "guideline", "url": "https://www.chinalipid.org/guideline/2023", "published_at": "2023-06-30", "evidence_level": "guideline", "topic": "lipid", "pico_population": ["adults", "high risk"], "pico_intervention": ["statin", "ezetimibe", "pcsk9 inhibitor"], "pico_comparator": [], "pico_outcome": ["ldl", "ldl-c"], "page": "12-19", "section": "药物治疗", "token_count": 0, "pmid": "", "doi": "10.3760/cma.j.cn112148-20230630-00420", "nct_id": "", "authors": ["中国血脂管理指南修订联合专家委员会"], "guideline_name": "中国血脂管理指南（2023年）", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "lipid-rct-rosuvastatin", "evidence_id": "ev-lipid-rct-rosuvastatin", "stable_id": "PMID:32100010", "title": "Rosuvastatin in patients with dyslipidemia: a randomized placebo-controlled trial", "text": "In this randomized placebo-controlled trial, 900 adults with dyslipidemia received rosuvastatin 10-20 mg or placebo for 12 months. Rosuvastatin reduced LDL cholesterol by 45% and was well tolerated; no effect on cardiovascular events could be detected within the trial period.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/32100010/", "published_at": "2020-08-01", "evidence_level": "rct", "topic": "lipid", "pico_population": ["adults", "dyslipidemia"], "pico_intervention": ["statin", "rosuvastatin"], "pico_comparator": ["placebo"], "pico_outcome": ["ldl", "ldl-c"], "page": "", "section": "abstract", "token_count": 0, "pmid": "32100010", "doi": "10.1000/jacc.2020.08.001", "nct_id": "", "authors": ["Nguyen T", "Silva M"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "lipid-rct-ezetimibe", "evidence_id": "ev-lipid-rct-ezetimibe", "stable_id": "PMID:33300011", "title": "Ezetimibe added to statin therapy in high-risk patients: a randomized trial", "text": "A randomized trial of 1,600 high-risk patients with LDL cholesterol above target on statin monotherapy added ezetimibe 10 mg or placebo for 24 months. Adding ezetimibe further reduced LDL cholesterol by 21% and reduced major cardiovascular events, with a safety profile similar to placebo.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/33300011/", "published_at": "2022-03-25", "evidence_level": "rct", "topic": "lipid", "pico_population": ["high risk", "dyslipidemia"], "pico_intervention": ["ezetimibe", "statin"], "pico_comparator": ["placebo"], "pico_outcome": ["ldl", "ldl-c", "cardiovascular events"], "page": "", "section": "abstract", "token_count": 0, "pmid": "33300011", "doi": "10.1000/nejm.2022.03.025", "nct_id": "", "authors": ["Andersson K", "Rossi P"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "lipid-sr-statin", "evidence_id": "ev-lipid-sr-statin", "stable_id": "DOI:10.1000/lipidsr2020", "title": "Statins for primary prevention of cardiovascular disease: a systematic review", "text": "This systematic review of 26 trials found statin therapy reduced major cardiovascular events in primary prevention populations, with larger absolute benefits in higher-risk patients. LDL cholesterol reduction is the main determinant of benefit.", "source_type": "europepmc", "url": "https://europepmc.org/article/MED/lipidsr2020", "published_at": "2020-11-11", "evidence_level": "systematic_review", "topic": "lipid", "pico_population": ["adults", "high risk"], "pico_intervention": ["statin"], "pico_comparator": ["placebo"], "pico_outcome": ["ldl", "cardiovascular events"], "page": "", "section": "abstract", "token_count": 0, "pmid": "", "doi": "10.1000/lipidsr2020", "nct_id": "", "authors": ["Chou R", "Dana T"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "lipid-trial-2024", "evidence_id": "ev-lipid-trial-2024", "stable_id": "NCT06600012", "title": "Low-dose ezetimibe plus statin versus doubled statin dose: a 2024 randomized trial", "text": "A 2024 randomized trial compared low-dose ezetimibe added to statin with doubling the statin dose in 1,100 patients with dyslipidemia. The ezetimibe combination achieved greater LDL reduction with fewer muscle-related symptoms.", "source_type": "trials", "url": "https://clinicaltrials.gov/study/NCT06600012", "published_at": "2024-10-05", "evidence_level": "trial", "topic": "lipid", "pico_population": ["adults", "dyslipidemia"], "pico_intervention": ["ezetimibe", "statin"], "pico_comparator": ["statin"], "pico_outcome": ["ldl", "ldl-c"], "page": "", "section": "results", "token_count": 0, "pmid": "", "doi": "", "nct_id": "NCT06600012", "authors": ["Hansen L", "Weber G"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
{"chunk_id": "lipid-cohort", "evidence_id": "ev-lipid-cohort", "stable_id": "PMID:34400013", "title": "Lipid levels and long-term outcomes in a population cohort", "text": "This population cohort observed lipid trajectories over ten years. Sustained elevations of LDL cholesterol were associated with higher cardiovascular risk, but the study reports associations and not drug effects.", "source_type": "pubmed", "url": "https://pubmed.ncbi.nlm.nih.gov/34400013/", "published_at": "2023-01-20", "evidence_level": "cohort", "topic": "lipid", "pico_population": ["adults"], "pico_intervention": [], "pico_comparator": [], "pico_outcome": ["cardiovascular events"], "page": "", "section": "abstract", "token_count": 0, "pmid": "34400013", "doi": "", "nct_id": "", "authors": ["Meyer A", "Clark B"], "guideline_name": "", "fetched_at": "2026-08-10T09:00:00Z", "is_tombstoned": false, "index_version": "idx-20260811-v1", "corpus_version": "corpus-20260811-v1"}
