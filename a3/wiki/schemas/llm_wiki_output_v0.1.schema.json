{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openevidence.local/schemas/a3/llm-wiki-output-v0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["topics"],
  "properties": {
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "entries"],
        "properties": {
          "slug": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "evidence_id", "span_id"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "evidence_id": {"type": "string", "minLength": 1},
                "span_id": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
