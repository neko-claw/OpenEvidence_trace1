{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openevidence.local/schemas/dataset_manifest.schema.json",
  "title": "OpenEvidence DatasetManifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_version",
    "manifest_version",
    "created_at",
    "corpus_cutoff",
    "source_datasets",
    "licenses",
    "hash_algorithm",
    "split_hashes",
    "split_lifecycle",
    "source_group_policy",
    "source_group_audit",
    "dedup_steps",
    "known_gaps"
  ],
  "properties": {
    "dataset_version": {"type": "string", "pattern": "^openevidence-question-bank-v[0-9]+\\.[0-9]+$"},
    "manifest_version": {"const": "dataset-manifest-v0.2"},
    "created_at": {"type": "string", "format": "date-time"},
    "corpus_cutoff": {"type": "string", "format": "date"},
    "source_datasets": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "licenses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_bank", "evidence_sources", "external_pack"],
      "properties": {
        "question_bank": {"type": "string"},
        "evidence_sources": {"type": "array", "items": {"type": "string"}},
        "external_pack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evaluation_eligible", "notes"],
          "properties": {
            "status": {"const": "LICENSE_AND_PROVENANCE_PENDING"},
            "evaluation_eligible": {"const": false},
            "notes": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "hash_algorithm": {"const": "sha256(concat(canonical_json(record,sort_keys=true,separators=(',',':'))))"},
    "split_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DEV", "TEST", "STRESS", "EXTERNAL", "RESERVE"],
      "properties": {
        "DEV": {"$ref": "#/$defs/hash"},
        "TEST": {"$ref": "#/$defs/hash"},
        "STRESS": {"$ref": "#/$defs/hash"},
        "EXTERNAL": {"$ref": "#/$defs/hash"},
        "RESERVE": {"$ref": "#/$defs/hash"}
      }
    },
    "split_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DEV", "TEST", "STRESS", "EXTERNAL", "RESERVE"],
      "properties": {
        "DEV": {"$ref": "#/$defs/splitState"},
        "TEST": {"$ref": "#/$defs/splitState"},
        "STRESS": {"$ref": "#/$defs/splitState"},
        "EXTERNAL": {"$ref": "#/$defs/splitState"},
        "RESERVE": {"$ref": "#/$defs/splitState"}
      }
    },
    "source_group_policy": {"type": "string", "minLength": 1},
    "source_group_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "total_groups", "singleton_groups", "cross_split_collisions"],
      "properties": {
        "status": {"enum": ["PENDING_B2_DERIVATION_AUDIT", "VERIFIED"]},
        "total_groups": {"type": "integer", "minimum": 0},
        "singleton_groups": {"type": "integer", "minimum": 0},
        "cross_split_collisions": {"type": "integer", "minimum": 0}
      }
    },
    "dedup_steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "status", "owner", "result"],
        "properties": {
          "method": {"type": "string", "minLength": 1},
          "status": {"enum": ["EXECUTED_VERIFIED", "PLANNED_NOT_EXECUTED"]},
          "owner": {"type": "string", "minLength": 1},
          "result": {"type": ["string", "null"]},
          "candidate_threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "known_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "splitState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evaluation_eligible", "reason"],
      "properties": {
        "status": {"enum": ["A1_STRUCTURE_FROZEN", "B2_GOLD_PENDING", "LICENSE_AND_PROVENANCE_PENDING", "RESERVE_ONLY", "EVALUATION_FROZEN"]},
        "evaluation_eligible": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
