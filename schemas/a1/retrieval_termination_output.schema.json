        "PASS",
        "WARN",
        "REFUSE"
      ],
      "title": "Decision",
      "type": "string"
    },
    "TerminationAction": {
      "enum": [
        "CONTINUE",
        "RETRY",
        "WARN",
        "REFUSE"
      ],
