{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openevidence.local/schemas/question.schema.json",
  "title": "OpenEvidence Question v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "split",
    "dataset_pack",
    "topic",
    "difficulty",
    "language",
    "question",
    "question_type",
    "answerable",
    "as_of_date",
    "source_provenance",
    "source_group_id",
    "gold_source_ids",
    "rubric_version",
    "expected_source_types",
    "critical_answer_points",
    "contraindicating_evidence",
    "penalty_points",
    "evidence_gap_label",
    "review_status"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^(DEV|TEST|STRESS|EXTERNAL|RESERVE)-(HTN|LIP)-[0-9]{2,3}$"},
    "split": {"enum": ["DEV", "TEST", "STRESS", "EXTERNAL", "RESERVE"]},
    "dataset_pack": {"type": "string", "pattern": "^openevidence-(dev|test|stress|external|reserve)-v[0-9]+\\.[0-9]+$"},
    "topic": {"enum": ["hypertension", "dyslipidemia"]},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "language": {"enum": ["zh-CN", "en"]},
    "question": {"type": "string", "minLength": 8},
    "question_type": {
      "enum": [
        "stable_mechanism",
        "guideline_treatment",
        "latest_research_trial",
        "insufficient_conflict_out_of_scope"
      ]
    },
    "answerable": {"type": "boolean"},
    "as_of_date": {"type": "string", "format": "date"},
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "authoring_method", "candidate_sources"],
      "properties": {
        "origin": {"enum": ["a1_blueprint", "teacher", "guideline", "literature", "public_benchmark"]},
        "authoring_method": {"type": "string"},
        "candidate_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_type", "stable_id", "url", "role", "verification_status"],
            "properties": {
              "source_type": {"enum": ["pubmed", "clinicaltrials", "guideline", "official_health", "search_route", "safety_policy"]},
              "stable_id": {"type": "string"},
              "url": {"type": "string"},
              "role": {
                "enum": ["candidate_gold", "candidate_support", "candidate_conflict", "routing_only"],
                "description": "candidate_gold 仅表示优先人工核验候选，不等于已经进入 gold_source_ids。"
              },
              "verification_status": {"enum": ["source_exists_a1", "pending_a2_ingestion", "pending_b2_gold_review"]}
            }
          }
        }
      }
    },
    "source_group_id": {"type": "string", "pattern": "^SG-(DEV|TEST|STRESS|EXTERNAL|RESERVE)-(HTN|LIP)-[0-9]{2,3}$"},
    "gold_source_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "description": "A1 阶段保持为空；A2 入库后由 B2 人工核验并在冻结版写入 Evidence ID。"
    },
    "rubric_version": {"type": "string", "pattern": "^rubric-(candidate|frozen)-v[0-9]+\\.[0-9]+$"},
    "expected_source_types": {
      "type": "array",
      "items": {"enum": ["pubmed_review", "pubmed_trial", "clinicaltrials_record", "current_guideline", "official_health_page", "none_required_for_scope_refusal"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "critical_answer_points": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "contraindicating_evidence": {"type": "array", "items": {"type": "string"}},
    "penalty_points": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evidence_gap_label": {"enum": ["none_expected", "results_not_posted", "guideline_conflict", "patient_specific_data_missing", "acute_care_out_of_scope", "malicious_or_fabricated_reference"]},
    "review_status": {"enum": ["A1_COMPLETE_B2_GOLD_PENDING", "B2_REVIEWED", "B2_ADJUDICATED", "RETIRED"]}
  }
}
