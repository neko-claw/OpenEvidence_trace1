{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "run_id": {
          "default": "",
          "title": "Run Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "criticality": {
          "$ref": "#/$defs/ClaimCriticality"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_span_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Span Ids",
          "type": "array"
        },
        "uncertainty": {
          "$ref": "#/$defs/UncertaintyLevel",
          "default": "UNKNOWN"
        },
        "entailment_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entailment Score"
        },
        "population": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "intervention": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intervention"
        },
        "comparator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparator"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "as_of_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of Date"
        },
        "population_match": {
          "$ref": "#/$defs/MatchStatus",
          "default": "UNKNOWN"
        },
        "intervention_match": {
          "$ref": "#/$defs/MatchStatus",
          "default": "UNKNOWN"
        },
        "comparator_match": {
          "$ref": "#/$defs/MatchStatus",
          "default": "UNKNOWN"
        },
        "outcome_match": {
          "$ref": "#/$defs/MatchStatus",
          "default": "UNKNOWN"
        },
        "time_match": {
          "$ref": "#/$defs/MatchStatus",
          "default": "UNKNOWN"
        },
        "conflict_ids": {
          "items": {
            "type": "string"
          },
          "title": "Conflict Ids",
          "type": "array"
        },
        "verification_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Method"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerificationStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "claim_id",
        "text",
        "criticality"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimCriticality": {
      "enum": [
        "critical",
        "important",
        "context"
      ],
      "title": "ClaimCriticality",
      "type": "string"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "description": "TEMPORARY COMPATIBILITY MODEL, not the frozen A2/A3 schema.\n\nUpstream records must be normalized to this narrow view by an adapter.\nMissing quality/provenance fields stay ``None`` and gates treat them as\nUNKNOWN; A5 never manufactures scores, evidence levels, spans, or dates.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_metadata": {
          "additionalProperties": true,
          "title": "Source Metadata",
          "type": "object"
        },
        "population": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "intervention": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intervention"
        },
        "comparator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparator"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "retrieval_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Score"
        },
        "retrieval_score_kind": {
          "$ref": "#/$defs/RetrievalScoreKind",
          "default": "UNKNOWN"
        },
        "retrieval_score_scope": {
          "$ref": "#/$defs/RetrievalScoreScope",
          "default": "UNKNOWN"
        },
        "retrieval_score_calibrated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Score Calibrated"
        },
        "evidence_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Level"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Spans",
          "type": "array"
        },
        "conflicts_with_ids": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts With Ids",
          "type": "array"
        },
        "mock": {
          "default": false,
          "title": "Mock",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "content",
        "source_type",
        "title"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "span_id": {
          "minLength": 1,
          "title": "Span Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "raw_page": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "offset_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset Scope"
        },
        "document_char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Char Start"
        },
        "document_char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Char End"
        },
        "span_content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Content Hash"
        },
        "chunk_content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Content Hash"
        },
        "evidence_content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Content Hash"
        }
      },
      "required": [
        "span_id",
        "text"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "MatchStatus": {
      "enum": [
        "MATCH",
        "MISMATCH",
        "UNKNOWN"
      ],
      "title": "MatchStatus",
      "type": "string"
    },
    "RetrievalScoreKind": {
      "enum": [
        "QUALITY",
        "RANKING",
        "UNKNOWN"
      ],
      "title": "RetrievalScoreKind",
      "type": "string"
    },
    "RetrievalScoreScope": {
      "enum": [
        "CROSS_QUERY",
        "QUERY_LOCAL",
        "UNKNOWN"
      ],
      "title": "RetrievalScoreScope",
      "type": "string"
    },
    "UncertaintyLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNKNOWN"
      ],
      "title": "UncertaintyLevel",
      "type": "string"
    },
    "VerificationContext": {
      "additionalProperties": false,
      "properties": {
        "freshness_required": {
          "default": false,
          "title": "Freshness Required",
          "type": "boolean"
        },
        "run_date": {
          "format": "date",
          "title": "Run Date",
          "type": "string"
        }
      },
      "title": "VerificationContext",
      "type": "object"
    },
    "VerificationStatus": {
      "enum": [
        "SUPPORTED",
        "CONTRADICTED",
        "INSUFFICIENT"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "context": {
      "$ref": "#/$defs/VerificationContext"
    }
  },
  "required": [
    "claims",
    "evidence"
  ],
  "title": "CitationAuditInput",
  "type": "object"
}
